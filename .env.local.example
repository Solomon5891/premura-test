NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Required for /admin dashboard. Service role key bypasses RLS so we can read
# the waitlist table (anon has no SELECT policy). Never expose to the client.
# Project Settings → API → service_role key in Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin dashboard. Any non-empty string. HTTP basic auth password
# (username is ignored). Pick something long.
ADMIN_PASSWORD=

# Optional. Slack Incoming Webhook URL for sub-5-min lead notifications.
# Create one: https://api.slack.com/messaging/webhooks
# Treat as a secret — anyone with the URL can post to your channel.
SLACK_WEBHOOK_URL=

# Optional. Upstash Redis for IP-based rate limiting (10 signups/IP/hour).
# Create a free DB at https://console.upstash.com/redis and copy REST URL + token.
# Without these, rate limiting is skipped (Turnstile remains the bot defense).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Cloudflare Turnstile invisible CAPTCHA.
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# Set BOTH keys together — server expects a token whenever the secret is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Apollo.io org enrichment by work-email domain.
# Get a key: https://app.apollo.io/settings/integrations/api
# Without this, signups still succeed — just without industry/employee/revenue
# data. 3-second timeout in lib/enrich.ts so a slow Apollo never blocks signup.
APOLLO_API_KEY=
